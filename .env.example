# =========================================================
# KLASÖRLER
# =========================================================
# Göreli yollar Automation klasörüne göre çözülür.
# Kod, ayar ve durum verileri:
AUTOMATION_ROOT=.
# Video 1, Video 2 ... proje klasörlerinin bulunduğu üst klasör:
PROJECTS_ROOT=..

# =========================================================
# AI SAĞLAYICISI
# gemini veya openai
# =========================================================
AI_PROVIDER=gemini

# Gemini kullanıyorsan:
GEMINI_API_KEY=BURAYA_GEMINI_API_ANAHTARINI_YAZ
GEMINI_MODEL=gemini-3.6-flash

# OpenAI kullanıyorsan:
OPENAI_API_KEY=BURAYA_OPENAI_API_ANAHTARINI_YAZ
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=low

# =========================================================
# ELEVENLABS SESLENDİRME
# =========================================================

# API anahtarları sırayla denenir. Kota/ödeme/erişim sorunu yaşayan anahtar
# atlanır ve bir sonraki dolu numaralı anahtara geçilir.
ELEVENLABS_API_KEY_1=BURAYA_BIRINCI_ELEVENLABS_API_ANAHTARINI_YAZ
ELEVENLABS_API_KEY_2=BURAYA_IKINCI_ELEVENLABS_API_ANAHTARINI_YAZ
ELEVENLABS_API_KEY_3=BURAYA_UCUNCU_ELEVENLABS_API_ANAHTARINI_YAZ

# Kullanılacak sesin ElevenLabs voice ID değeri. Adam premade sesi:
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Metinden sese dönüştürme modeli:
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# MP3, 44.1 kHz, 128 kbps:
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Konuşma hızı. Geçerli aralık 0.7-1.2; 1.0 normal hızdır.
ELEVENLABS_SPEED=1.0

# Ses tutarlılığı. 0 daha değişken/duygulu, 1 daha kararlı/tekdüzedir.
ELEVENLABS_STABILITY=0.5

# Üretilen sesin seçilen sese benzerliği. Geçerli aralık 0-1:
ELEVENLABS_SIMILARITY_BOOST=0.75

# Stil abartısı. 0 doğal/sade, 1 en güçlü stil uygulamasıdır.
ELEVENLABS_STYLE=0.5

# Seçilen sesin karakterini güçlendirir. true veya false:
ELEVENLABS_SPEAKER_BOOST=true

# Dil zorlamasını açar. false iken dil metinden otomatik belirlenir.
ELEVENLABS_IS_OVERRIDE=false

# Yalnızca IS_OVERRIDE=true olduğunda API'ye gönderilir (İngilizce: en):
ELEVENLABS_LANGUAGE_CODE=en

# Bir API isteğinin saniye cinsinden azami bekleme süresi:
ELEVENLABS_TIMEOUT=120

# Geçici ağ/sunucu hatalarında aynı anahtar için yeniden deneme sayısı:
ELEVENLABS_RETRIES=3

# Bir haber tek anahtarin kalan kotasindan buyukse, metni cumle
# sinirlarinda bolerek birden fazla anahtarin kalan kredisini kullanir.
# Parcalar sonucta tek MP3 dosyasi olarak kaydedilir:
ELEVENLABS_ALLOW_CREDIT_POOLING=true

# =========================================================
# HABER SEÇİMİ
# =========================================================
MAX_AGE_HOURS=36
MAX_CANDIDATES=25
MAX_FEED_ITEMS=30
TOP_N=5
MIN_SCORE=65
MIN_ARTICLE_CHARS=500

# =========================================================
# AĞ VE YENİDEN DENEME
# =========================================================
REQUEST_TIMEOUT=25
API_RETRIES=3
RSS_RETRIES=2

USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 RSSNewsAutomation/1.0
