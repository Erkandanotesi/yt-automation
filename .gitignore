# ==============================================================================
# Secrets, Credentials & Local Config Overrides
# ==============================================================================
**/.env
**/.env.*
!**/.env.example
Automation/.youtube_credentials/
**/client_secret*.json
**/youtube_token*.json
Automation/data/env_backups/

# ==============================================================================
# Python Environments, Caches & Build Artifacts
# ==============================================================================
Automation/.venv/
Automation/.venv_qwen/
.venv/
.venv_qwen/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# .NET / WPF Build Artifacts
Automation/NewsStudio.App/**/bin/
Automation/NewsStudio.App/**/obj/
.vs/

# ==============================================================================
# Generated Projects, Large Media Assets & Local AI Models
# ==============================================================================
Projects/*
!Projects/.gitkeep

Assets/*
!Assets/.gitkeep

models/*
!models/.gitkeep

