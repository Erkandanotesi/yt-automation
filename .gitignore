# Local secrets
.env
.env.*
!.env.example
.youtube_credentials/
client_secret*.json
youtube_token*.json

# Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and interrupted writes
*.log
*.part
*.tmp

# Runtime state and regenerable local indexes
data/processed_urls.json
data/news_archive/*
!data/news_archive/.gitkeep
data/indexes/media_index.json
data/indexes/media_index_report.json
data/indexes/online_searches/

# Legacy/generated video projects do not belong in the code repository
Video*/
Old/

# Portable third-party binaries
tools/ffmpeg/

# Local editor and operating-system files
.idea/
.vscode/
Thumbs.db
Desktop.ini
