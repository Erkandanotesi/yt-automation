<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>FeedFlow RSS feeds</title>
  </head>
  <body>
    <!--
      Bu bir şablondur.
      FeedFlow uygulamasından gerçek OPML dosyanı dışa aktar ve bu dosyanın
      üzerine D:\Dosyalar\Automation\feeds.opml adıyla kaydet.

      Örnek biçim:
      <outline text="Kaynak adı"
               title="Kaynak adı"
               type="rss"
               xmlUrl="https://example.com/feed.xml"
               htmlUrl="https://example.com/" />
    -->
  </body>
</opml>
