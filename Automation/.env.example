# =========================================================
# KLASÖRLER
# =========================================================
# Göreli yollar Automation klasörüne göre çözülür.
# Kod, ayar ve durum verileri:
AUTOMATION_ROOT=.
# Video 1, Video 2 ... proje klasörlerinin bulunduğu üst klasör:
PROJECTS_ROOT=../Projects

# Narration length. The target guides the writer; min/max are enforced by
# validation and local trimming.
NARRATION_MIN_WORDS=350
NARRATION_TARGET_WORDS=360
NARRATION_MAX_WORDS=390

# =========================================================
# AI SAĞLAYICISI
# gemini veya openai
# =========================================================
AI_PROVIDER=gemini

# Gemini kullanıyorsan:
GEMINI_API_KEY=BURAYA_GEMINI_API_ANAHTARINI_YAZ
GEMINI_MODEL=gemini-3.6-flash

# OpenAI kullanıyorsan:
OPENAI_API_KEY=BURAYA_OPENAI_API_ANAHTARINI_YAZ
OPENAI_MODEL=gpt-5.6-luna
OPENAI_NEWS_SELECTION_MODEL=gpt-5.6-luna
OPENAI_NEWS_SELECTION_REASONING_EFFORT=medium
OPENAI_REASONING_EFFORT=medium

# Persistent pulled-news archive and cross-feed duplicate detection.
# Exact hashes are free; only plausible non-identical matches are sent to AI.
NEWS_ARCHIVE_PATH=data/news_archive
NEWS_DUPLICATE_CANDIDATE_LIMIT=3
NEWS_DUPLICATE_LOCAL_THRESHOLD=0.30
NEWS_DUPLICATE_AI_MIN_CONFIDENCE=0.90
NEWS_DUPLICATE_AI_TEXT_LIMIT=12000

# Milestone 4: Luna yalnizca iki gorsel ani secer ve prompt yazar.
# Pikseller ayri GPT Image 2 modelinden gelir.
STORYBOARD_MODEL=gpt-5.6-luna
STORYBOARD_REASONING_EFFORT=medium
STORYBOARD_API_RETRIES=2
STORYBOARD_MAX_SOURCE_CHARACTERS=12000
OPENAI_IMAGE_MODEL=gpt-image-2
# Dengeli uretim ayari. Canli smoke testi kod tarafinda otomatik olarak low kullanir.
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1280x720
OPENAI_IMAGE_FORMAT=png
AI_IMAGE_ARCHIVE_DIRECTORY=../Assets/Media/AI Generated
OPENAI_IMAGE_TIMEOUT=180
# Uretim komutu ayrica --confirm-cost ister.
# Number of paid AI hero images created for each news story (0-4).
AI_GENERATED_IMAGES_PER_STORY=2
# Dedicated publishing thumbnail generation is independent of story-image count.
AI_GENERATED_THUMBNAIL_ENABLED=true
# This limit applies to story images, not the one publishing thumbnail request.
# For story images it must be at least TOP_N * AI_GENERATED_IMAGES_PER_STORY.
# Supports up to three stories with four hero-image requests each.
MAX_IMAGE_REQUESTS_PER_RUN=12
IMAGE_DUPLICATE_HAMMING_THRESHOLD=6

# Milestone 5: local media index and archive-image selection.
# Both Assets/Media and Assets/Media (No-Copyright) are scanned automatically.
MEDIA_INDEX_PATH=data/indexes/media_index.json
MEDIA_INDEX_WORKERS=6
MEDIA_MIN_WIDTH=320
MEDIA_MIN_HEIGHT=180
MEDIA_CROP_RETENTION_THRESHOLD=0.55
MEDIA_SELECTION_MODEL=gpt-5.6-luna
MEDIA_SELECTION_REASONING_EFFORT=medium
MEDIA_SHORTLIST_SIZE=8
MEDIA_MIN_WINDOW_SECONDS=5
MEDIA_TARGET_WINDOW_SECONDS=7
MEDIA_MAX_WINDOW_SECONDS=9
MEDIA_MIN_LOCAL_SCORE=1
MEDIA_SELECTION_API_RETRIES=2
MEDIA_SELECTION_TIMEOUT=120
# Reject low-confidence or misleading local choices and continue through the
# configured online-provider fallbacks.
MEDIA_MIN_AI_CONFIDENCE=0.45
# A single media file may appear in at most this many visual windows per video.
MEDIA_MAX_USES_PER_VIDEO=2
# false keeps immutable source path + SHA-256 instead of copying archive images.
MEDIA_COPY_SELECTED=false

# Visual scene mix. Motion graphics are animations; stock video fills the remainder.
# The planner accepts a +/-5 percentage-point band because timed windows are indivisible.
MOTION_GRAPHIC_TARGET_PERCENT=35

# Primary contextual visuals: Pexels Videos, then Pixabay Videos. The planner sees
# the exact timed clause plus its full sentence, but each provider receives a short,
# concrete 2-6 word search phrase. Candidate previews are checked before download.
STOCK_VIDEO_ENABLED=true
PEXELS_API_KEY=
PIXABAY_API_KEY=
PEXELS_VIDEO_ENABLED=true
PIXABAY_VIDEO_ENABLED=true
STOCK_VIDEO_QUERY_MODEL=gpt-5.6-luna
STOCK_VIDEO_QUERY_REASONING_EFFORT=low
STOCK_VIDEO_REVIEW_MODEL=gpt-5.6-luna
STOCK_VIDEO_REVIEW_REASONING_EFFORT=low
STOCK_VIDEO_REVIEW_CANDIDATE_LIMIT=4
STOCK_VIDEO_MIN_REVIEW_CONFIDENCE=0.65
# Longer three-story episodes need denser visual coverage. These are ceilings,
# not guaranteed calls; the limit applies independently to Pexels and Pixabay.
STOCK_VIDEO_MAX_DOWNLOADS_PER_VIDEO=80
STOCK_VIDEO_MAX_SEARCHES_PER_PROVIDER=80
STOCK_VIDEO_REQUEST_INTERVAL=0.25
STOCK_VIDEO_REQUEST_RESULT_LIMIT=20
STOCK_VIDEO_CANDIDATE_LIMIT=6
STOCK_VIDEO_TIMEOUT=30
STOCK_VIDEO_MAX_DOWNLOAD_BYTES=200000000
STOCK_VIDEO_MIN_WIDTH=1280
STOCK_VIDEO_MIN_HEIGHT=720
STOCK_VIDEO_MAX_SOURCE_DURATION=120
STOCK_VIDEO_LOCK_TIMEOUT=30
# Optional relative or absolute overrides. Blank uses Assets/Media/Online Retrieved.
PEXELS_VIDEO_DESTINATION=
PIXABAY_VIDEO_DESTINATION=

# Image fallback order after both video providers fail: indexed local images, then
# Unsplash. A designed contextual card remains the final safe fallback.
UNSPLASH_API_KEY=
UNSPLASH_FALLBACK_ENABLED=true
UNSPLASH_QUERY_MODEL=gpt-5.6-luna
UNSPLASH_QUERY_REASONING_EFFORT=low
UNSPLASH_MAX_DOWNLOADS_PER_VIDEO=30
UNSPLASH_MAX_SEARCHES_PER_VIDEO=30
UNSPLASH_REQUEST_INTERVAL=0.25
UNSPLASH_REQUEST_RESULT_LIMIT=24
UNSPLASH_SEARCH_LIMIT=8
UNSPLASH_TIMEOUT=30
UNSPLASH_MAX_DOWNLOAD_BYTES=25000000
UNSPLASH_MIN_WIDTH=640
UNSPLASH_MIN_HEIGHT=360
UNSPLASH_MIN_RELEVANCE_SCORE=12
UNSPLASH_CONTENT_FILTER=high
UNSPLASH_LOCK_TIMEOUT=30

# =========================================================
# SOUND LEVELS
# =========================================================
# GAIN_DB controls relative volume: 0 = unchanged, -3 = quieter, +3 = louder.
# Voice narration. Start with +/- 1 to 3 dB changes.
VOICEOVER_GAIN_DB=0.0
# Audio already embedded in manually produced separator videos.
SEPARATOR_AUDIO_GAIN_DB=-9.0
# Individual sound effects. More-negative values make them quieter.
GLITCH_SFX_GAIN_DB=-24.0
PAPER_SFX_GAIN_DB=-10.0
SHUTTER_SFX_GAIN_DB=-10.0
# Music is normalized to TARGET_LUFS, then reduced by the appropriate GAIN_DB.
# Lower/more-negative values are quieter. SPEECH applies during narration;
# SEPARATOR applies while a manual separator is visible.
BACKGROUND_MUSIC_TARGET_LUFS=-20.0
BACKGROUND_MUSIC_SPEECH_GAIN_DB=-24.0
BACKGROUND_MUSIC_SEPARATOR_GAIN_DB=-18.0
# Final master loudness. Keep TRUE_PEAK at or below -1.0 dB to prevent clipping.
# Changing FINAL_TARGET_LUFS affects the complete mix, not one sound category.
FINAL_TARGET_LUFS=-14.0
FINAL_TRUE_PEAK_DB=-1.5

# Milestone 6: deterministic motion, CapCut layer reference, TV frame,
# controlled glitch/SFX, and repeated/ducked background music.
EFFECTS_WIDTH=1920
EFFECTS_HEIGHT=1080
EFFECTS_FPS=30
# Smooth center push-in. Floating-point cubic rendering avoids whole-pixel stepping.
EFFECTS_MOTION_SCALE=1.025
EFFECTS_HERO_MOTION_SCALE=1.01875
EFFECTS_MAX_VISUAL_HOLD_SECONDS=9
EDITING_REFERENCE_FILE=references/capcut_screenshot.png
IMAGE_TV_EFFECT_ENABLED=true
IMAGE_TV_EFFECT_FILE=../Assets/Overlays/green-screen-tv-effect.mov
# Preserve native alpha but fade the authored effect so it stays atmospheric.
IMAGE_TV_EFFECT_OPACITY=0.18
# The separate procedural noise/dropout effect is disabled by default; the subtle
# alpha MOV remains active on images and is still excluded from separators.
GLITCH_ENABLED=false
GLITCH_DURATION_SECONDS=0.08
GLITCH_MAX_PER_MINUTE=1
GLITCH_MINIMUM_SPACING_SECONDS=10
GLITCH_NOISE_STRENGTH=2
PAPER_SFX_ENABLED=true
PAPER_SFX_FILE=../Assets/Audio/sfx/paper_sound.MP3
SHUTTER_SFX_ENABLED=true
SHUTTER_SFX_FILE=../Assets/Audio/sfx/shutter_sound.MP3
BACKGROUND_MUSIC_ENABLED=true
BACKGROUND_MUSIC_DIRECTORY=../Assets/Audio/background_music
# Always assign this track to story 01; relative paths resolve from Automation/.
FIRST_BACKGROUND_MUSIC=../Assets/Audio/background_music/Tech_News_Glow 2.mp3
# Leave empty to choose the first user-supplied track deterministically.
BACKGROUND_MUSIC_FILE=
BACKGROUND_MUSIC_LOOP_CROSSFADE_SECONDS=0.35
# Adjacent story tracks use: fade out -> silence -> fade in.
BACKGROUND_MUSIC_SECTION_FADE_SECONDS=3.0
BACKGROUND_MUSIC_SECTION_SILENCE_SECONDS=1.0
BACKGROUND_MUSIC_FADE_SECONDS=3
EFFECTS_PROOF_WIDTH=960
EFFECTS_PROOF_HEIGHT=540

# Milestone 8: complete preview and final FFmpeg render.
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
PREVIEW_WIDTH=960
PREVIEW_HEIGHT=540
RENDER_FPS=30
RENDER_SEGMENT_CRF=18
RENDER_FINAL_CRF=20
RENDER_PREVIEW_CRF=25
RENDER_PRESET=veryfast
# Independent visual segments are safe to encode concurrently. Four workers and
# four video-filter threads are conservative defaults for an 8-core/16-thread CPU.
RENDER_SEGMENT_WORKERS=4
RENDER_VIDEO_FILTER_THREADS=4
# Delete animation segments after base creation and all remaining intermediates
# only after the final video and preview pass QA.
RENDER_CLEANUP_INTERMEDIATES=true
CAPTION_MARGIN_VERTICAL=24
TITLE_FONT_SIZE=30
TITLE_MARGIN_LEFT=0
TITLE_MARGIN_TOP=70
ATTRIBUTION_FONT_SIZE=20
ATTRIBUTION_MARGIN_RIGHT=0
ATTRIBUTION_MARGIN_BOTTOM=8
PAGE_FLIP_ENABLED=true
# Applied at every chapter start only when manual separators are skipped.
PAGE_FLIP_DURATION_SECONDS=0.7

# SRT remains portable; ASS is burned in with the currently spoken word in yellow.
CAPTION_MAX_CHARACTERS_PER_LINE=42
CAPTION_MAX_LINES=2
CAPTION_MAX_WORDS=9
CAPTION_MIN_DURATION_SECONDS=0.35

# =========================================================
# MILESTONE 9 / PUBLISHING AND THUMBNAIL
# =========================================================
PUBLISH_MODEL=gpt-5.6-luna
PUBLISH_REASONING_EFFORT=medium
PUBLISH_TIMEOUT=120
PUBLISH_API_RETRIES=2
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720
THUMBNAIL_PHONE_WIDTH=320
THUMBNAIL_PHONE_HEIGHT=180
THUMBNAIL_FONT_FILE=C:/Windows/Fonts/impact.ttf
THUMBNAIL_IMAGE_MODEL=gpt-image-2
THUMBNAIL_IMAGE_QUALITY=medium
THUMBNAIL_IMAGE_SIZE=1280x720
THUMBNAIL_IMAGE_FORMAT=png

# Milestone 10: approval is bound to the current 60-second preview checksum.
REQUIRE_PREVIEW_APPROVAL=true
# Every autonomous launcher choice waits at least 2 minutes for manual input.
AUTOMATION_DECISION_TIMEOUT_SECONDS=120
AUTOMATION_UPLOAD_TIMEOUT_SECONDS=120

# YOUTUBE UPLOAD
# Download an OAuth Desktop app client JSON from Google Cloud and keep it in
# this ignored folder. Run scripts\youtube_authorize.bat once; it opens a browser
# and caches a refresh token locally without uploading a video.
YOUTUBE_CLIENT_SECRETS_FILE=.youtube_credentials/client_secret.json
YOUTUBE_TOKEN_FILE=.youtube_credentials/youtube_token.json
YOUTUBE_SCHEDULE_STATE_FILE=data/youtube_schedule_state.json
# Start at the nearest future 20:00 GMT+3 slot and skip only slots occupied on YouTube.
# The interval controls how far to advance when a live scheduled video occupies a slot.
YOUTUBE_PUBLISH_HOUR=20
YOUTUBE_PUBLISH_INTERVAL_DAYS=2
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28
YOUTUBE_DEFAULT_LANGUAGE=en
YOUTUBE_NOTIFY_SUBSCRIBERS=false
YOUTUBE_UPLOAD_CHUNK_SIZE=8388608
YOUTUBE_UPLOAD_MAX_RETRIES=8

# =========================================================
# TTS SAGLAYICI SECIMI (qwen VEYA elevenlabs)
# =========================================================
# 'qwen' -> Yerel GPU uzerinde Qwen3-TTS 1.7B-CustomVoice
# 'elevenlabs' -> ElevenLabs API
TTS_PROVIDER=elevenlabs
QWEN_TTS_SPEAKER=ryan
QWEN_TTS_INSTRUCTION=Speak with clear confidence and an energetic, engaging tech podcast tone.
QWEN_TTS_LANGUAGE=English

# =========================================================
# ELEVENLABS SESLENDİRME
# =========================================================

# API anahtarları sırayla denenir. Kota/ödeme/erişim sorunu yaşayan anahtar
# atlanır ve bir sonraki dolu numaralı anahtara geçilir.
ELEVENLABS_API_KEY_1=BURAYA_BIRINCI_ELEVENLABS_API_ANAHTARINI_YAZ
ELEVENLABS_API_KEY_2=BURAYA_IKINCI_ELEVENLABS_API_ANAHTARINI_YAZ
ELEVENLABS_API_KEY_3=BURAYA_UCUNCU_ELEVENLABS_API_ANAHTARINI_YAZ

# Kullanılacak sesin ElevenLabs voice ID değeri. Adam premade sesi:
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Metinden sese dönüştürme modeli:
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# AI-driven inline emotion/expression tags ([serious], [skeptical], [excited], etc.).
# Requires an Eleven v3/v4 model such as eleven_v4_turbo or eleven_v3.
ELEVENLABS_EMOTIONS_ENABLED=true

# MP3, 44.1 kHz, 128 kbps:
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Konuşma hızı. Geçerli aralık 0.7-1.2; 1.0 normal hızdır.
ELEVENLABS_SPEED=1.0

# Ses tutarlılığı. 0 daha değişken/duygulu, 1 daha kararlı/tekdüzedir.
ELEVENLABS_STABILITY=0.5

# Üretilen sesin seçilen sese benzerliği. Geçerli aralık 0-1:
ELEVENLABS_SIMILARITY_BOOST=0.75

# Stil abartısı. 0 doğal/sade, 1 en güçlü stil uygulamasıdır.
ELEVENLABS_STYLE=0.5

# Seçilen sesin karakterini güçlendirir. true veya false:
ELEVENLABS_SPEAKER_BOOST=true

# Dil zorlamasını açar. false iken dil metinden otomatik belirlenir.
ELEVENLABS_IS_OVERRIDE=false

# Yalnızca IS_OVERRIDE=true olduğunda API'ye gönderilir (İngilizce: en):
ELEVENLABS_LANGUAGE_CODE=en

# Bir API isteğinin saniye cinsinden azami bekleme süresi:
ELEVENLABS_TIMEOUT=120

# Geçici ağ/sunucu hatalarında aynı anahtar için yeniden deneme sayısı:
ELEVENLABS_RETRIES=3

# Bir haber tek anahtarin kalan kotasindan buyukse, metni cumle
# sinirlarinda bolerek birden fazla anahtarin kalan kredisini kullanir.
# Parcalar sonucta tek MP3 dosyasi olarak kaydedilir:
ELEVENLABS_ALLOW_CREDIT_POOLING=true

# story_timing.json içinde her haberden önce ayrılacak manuel separator süresi.
# Gerçek separator süreleri Milestone 3'te dosyalardan okunacaktır:
SEPARATOR_DURATION_SECONDS=3.0
INTER_STORY_GAP_SECONDS=2.0

# Manuel separator dışa aktarma kalite kapısı:
SEPARATOR_WIDTH=1920
SEPARATOR_HEIGHT=1080
SEPARATOR_FPS=30
SEPARATOR_FPS_TOLERANCE=0.05
SEPARATOR_ALLOWED_CODECS=h264,hevc
SEPARATOR_ALLOWED_PIXEL_FORMATS=yuv420p,yuv420p10le
# consistent: dosyaların hepsinde ses olmalı veya hiçbirinde olmamalı.
# Diğer seçenekler: require, forbid, allow_mixed
SEPARATOR_AUDIO_POLICY=consistent
SEPARATOR_MIN_DURATION_SECONDS=0.1
# Opens Haberler first and 03_manual_separators second when work pauses.
AUTO_OPEN_SEPARATOR_FOLDERS=true

# =========================================================
# HABER SEÇİMİ
# =========================================================
# Only RSS entries published within this many hours are eligible (whole hours, minimum 1).
RSS_FEED_TIME_INTERVAL_HOURS=24
MAX_CANDIDATES=80
# Size of the publisher-balanced, headline-diverse pool sent in one ranking request.
NEWS_SELECTION_CANDIDATE_COUNT=40
# Headlines at or above this containment similarity are deferred from the AI pool.
NEWS_SELECTION_TITLE_SIMILARITY_THRESHOLD=0.60
MAX_FEED_ITEMS=30
# Three longer stories per episode.
TOP_N=3
# Okunamayan/geçersiz ana haberlerin yerine aynı sıralama çağrısından kullanılacak
# yedek aday sayısı:
RANKING_RESERVE=15
# true ise tam TOP_N haber oluşmadan proje tamamlanmış sayılmaz ve URL geçmişi
# güncellenmez:
REQUIRE_FULL_TOP_N=true
# Primary editorial threshold. Lower-ranked items are tried only if needed to reach TOP_N.
MIN_SCORE=50
MIN_ARTICLE_CHARS=800

# =========================================================
# AĞ VE YENİDEN DENEME
# =========================================================
REQUEST_TIMEOUT=25
API_RETRIES=3
RSS_RETRIES=2
NETWORK_RETRY_INTERVAL_SECONDS=15
# Comma-separated host:port probes used only after a detected network failure.
NETWORK_PROBE_TARGETS=api.openai.com:443,api.elevenlabs.io:443,www.google.com:443,1.1.1.1:443

USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 RSSNewsAutomation/1.0
